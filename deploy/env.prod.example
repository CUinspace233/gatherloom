# Copy to deploy/.env.prod (git-ignored), fill in, and keep it private:
# it is also part of the backup (see docs/operations.md).

# Public host name pointing at this server. Caddy obtains the certificate.
GATHERLOOM_DOMAIN=gatherloom.example.com

# Database password. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Model providers (ADR 0001, 0002). Overseas servers use the Bailian
# international endpoint.
GATHERLOOM_BAILIAN_API_KEY=
GATHERLOOM_BAILIAN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
GATHERLOOM_DEEPSEEK_API_KEY=
GATHERLOOM_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
GATHERLOOM_LLM_LIGHT_PROVIDER=qwen
GATHERLOOM_LLM_LIGHT_MODEL=qwen3.8-flash
GATHERLOOM_LLM_HEAVY_PROVIDER=deepseek
GATHERLOOM_LLM_HEAVY_MODEL=deepseek-flash

# Worker threads (global concurrency).
GATHERLOOM_WORKER_CONCURRENCY=2

# Daily quotas per account; 0 turns a limit off.
GATHERLOOM_DAILY_ENTRIES=200
GATHERLOOM_DAILY_QUESTIONS=100
GATHERLOOM_DAILY_REVIEWS=10
GATHERLOOM_DAILY_BUDGET_CNY=5
GATHERLOOM_USD_CNY=7.2

# Memory limits; size them from the server inventory (roadmap S0).
# POSTGRES_MEMORY=1g
# API_MEMORY=512m
# WORKER_MEMORY=1g

# Backups (scripts/backup.sh): local directory, and optionally an off-site
# rsync or rclone destination.
BACKUP_DIR=/var/backups/gatherloom
BACKUP_KEEP_DAYS=14
# BACKUP_REMOTE=user@backup-host:/srv/backups/gatherloom
