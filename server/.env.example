# Copy to server/.env (git-ignored) and fill in values. Never commit real keys.
# Start the API with: uv run --locked --env-file .env uvicorn app.main:app
# Start the worker with: uv run --locked --env-file .env python -m app.worker
# Check the model setup with: uv run --locked --env-file .env python -m app.admin check-models

# Database and storage (defaults shown; local Docker Compose values)
# GATHERLOOM_DATABASE_URL=postgresql+psycopg://gatherloom:gatherloom-local@127.0.0.1:54329/gatherloom
# GATHERLOOM_STORAGE_DIR=var/storage

# Alibaba Cloud Model Studio (Bailian). One key covers embeddings and Qwen chat.
# Use the endpoint of the site your key comes from: China (Beijing) below, or
# international (Singapore) https://dashscope-intl.aliyuncs.com/compatible-mode/v1.
GATHERLOOM_BAILIAN_API_KEY=
GATHERLOOM_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek
GATHERLOOM_DEEPSEEK_API_KEY=
# GATHERLOOM_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Embedding (ADR 0001). The dimension is fixed by index_version 1; changing it
# needs a new index version and a backfill.
GATHERLOOM_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# GATHERLOOM_EMBEDDING_DIMENSION=1024

# Chat routing by task tier (ADR 0002). Provider is qwen or deepseek.
# Blank values use the defaults shown.
GATHERLOOM_LLM_LIGHT_PROVIDER=qwen
GATHERLOOM_LLM_LIGHT_MODEL=qwen3.7-flash-2026-07-15
GATHERLOOM_LLM_HEAVY_PROVIDER=deepseek
GATHERLOOM_LLM_HEAVY_MODEL=deepseek-v4-pro
# Optional fallback, used only for network and server errors, never for auth or billing errors.
# GATHERLOOM_LLM_FALLBACK_PROVIDER=deepseek
# GATHERLOOM_LLM_FALLBACK_MODEL=deepseek-flash

# Worker threads (global concurrency). Each account runs one job at a time.
# GATHERLOOM_WORKER_CONCURRENCY=2
