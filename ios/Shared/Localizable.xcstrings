      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatherloom"
          }
        }
      }
    },
    "Gatherloom 已切换账号。请重新分享，以免保存到错误的账号。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatherloom switched accounts. Share again so this isn't saved to the wrong account."
          }
        }
      }
    },
